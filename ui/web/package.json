{
  "name": "@synapse/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend-fixture": "cd ../.. && MIX_ENV=test mix compile --warnings-as-errors",
    "test:e2e": "npm run test:backend-fixture && npm run build && playwright test",
    "test:security": "node tests/security/source-build.mjs",
    "test:e2e:live": "node tests/live/run-live.mjs",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run test:security && npm run test:e2e"
  },
  "dependencies": {
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "globals": "17.9.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "ws": "8.21.2"
  }
}
