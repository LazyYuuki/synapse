%{
  "model" => "configured-model",
  "input" => [
    %{
      "type" => "message",
      "role" => "user",
      "content" => [%{"type" => "input_text", "text" => "Inspect and test the project"}]
    },
    %{
      "type" => "function_call",
      "id" => "item-read",
      "call_id" => "call-read",
      "name" => "read",
      "arguments" => "{\"limit\":null,\"offset\":null,\"path\":\"mix.exs\"}"
    },
    %{
      "type" => "function_call_output",
      "call_id" => "call-read",
      "output" => "{\"status\":\"ok\",\"tool\":\"read\"}"
    },
    %{
      "type" => "function_call",
      "id" => "item-test",
      "call_id" => "call-test",
      "name" => "bash",
      "arguments" => "{\"command\":\"mix test\",\"timeout_ms\":null}"
    },
    %{
      "type" => "function_call_output",
      "call_id" => "call-test",
      "output" => "{\"status\":\"ok\",\"tool\":\"bash\"}"
    }
  ],
  "tools" => [],
  "stream" => true,
  "store" => false
}
